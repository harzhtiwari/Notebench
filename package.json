{
  "name": "notebench",
  "version": "0.1.0",
  "description": "Open-source, web-first Google NotebookLM alternative with living editable media and surgical AI editing.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/harzhtiwari/Notebench.git"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "tsx tools/dev/src/dev.ts",
    "bench": "tsx tools/dev/src/benchmark.ts",
    "build": "turbo run build --cache-dir=.tmp/cache/turbo",
    "typecheck": "turbo run typecheck --cache-dir=.tmp/cache/turbo",
    "lint": "turbo run lint --cache-dir=.tmp/cache/turbo",
    "lint:tokens": "tsx scripts/lint-tokens.ts",
    "lint:licenses": "license-checker-rseidelsohn --production --excludePrivatePackages --onlyAllow 'MIT;Apache-2.0;BSD-2-Clause;BSD-3-Clause;ISC;0BSD'",
    "lint:boundaries": "depcruise --config .dependency-cruiser.cjs apps packages tools scripts examples",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "tsx scripts/e2e.ts",
    "test:postgres": "tsx scripts/test-postgres.ts",
    "test:mutation": "stryker run",
    "guard": "tsx scripts/guard.ts",
    "doctor": "tsx scripts/doctor.ts",
    "check:env": "tsx scripts/doctor.ts",
    "knip": "knip",
    "backup": "bash scripts/backup.sh",
    "restore": "bash scripts/restore.sh",
    "clean": "turbo run clean",
    "postinstall": "node -e \"if (require('fs').existsSync('tools/doc-tools')) require('child_process').execSync('uv sync --project tools/doc-tools', {stdio: 'inherit'})\""
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@playwright/test": "^1.64.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.4",
    "dependency-cruiser": "^18.6.0",
    "dotenv": "^18.0.7",
    "get-port": "^7.2.0",
    "knip": "^6.41.0",
    "lefthook": "^2.2.1",
    "license-checker-rseidelsohn": "^5.0.1",
    "tsdown": "^0.23.1",
    "tsx": "^4.19.2",
    "turbo": "^2.11.7",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
