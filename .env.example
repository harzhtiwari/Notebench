# ==============================================================================
# Notebench Environment Configuration (.env.example)
# Copy this file to .env.local for local development. Never commit .env.local.
# ==============================================================================

# Server Network Configuration (ARCHITECTURE.md Rule 4 & local-dev-and-deployment.md)
# Dev servers bind strictly to 127.0.0.1 (never bare localhost, never 0.0.0.0).
# Ports are dynamically allocated via get-port (avoiding EADDRINUSE conflicts).
# PORT, WEB_PORT, and SERVER_PORT are optional preferences; if taken or omitted, get-port allocates the next free port.
HOST=127.0.0.1
NODE_ENV=development
# PORT=3000
# WEB_PORT=3000
# SERVER_PORT=3001

# Database Configuration (SQLite default in dev; PostgreSQL in prod)
DATABASE_URL=file:.notebook/state/app.sqlite
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/notebench

# Storage Paths (Under .notebook/ persistent folder; auto-created at runtime)
NOTEBENCH_DATA_DIR=.notebook

# LLM Providers (Configure at least one local or cloud provider)
# Local inference via Ollama (default 127.0.0.1:11434)
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Cloud Providers (Optional)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
DEEPSEEK_API_KEY=

# Search Providers for Deep Web Research (Optional)
TAVILY_API_KEY=
BRAVE_API_KEY=
SEARXNG_BASE_URL=

# Error Tracking (Optional - Self-Hosted GlitchTip / Sentry only)
# Default is empty (Zero telemetry / zero reporting)
SENTRY_DSN=

# Telemetry Opt-Out Flags (Honored automatically)
DO_NOT_TRACK=1
NOTEBENCH_TELEMETRY_DISABLED=1
