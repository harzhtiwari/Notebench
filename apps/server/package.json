{
  "name": "@notebook/server",
  "version": "0.1.0",
  "description": "Fastify API server, composition root, and static SPA host for Notebench",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsdown",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/static": "^8.1.1",
    "@notebook/contracts": "workspace:*",
    "@notebook/infra-doc-worker": "workspace:*",
    "@notebook/logger": "workspace:*",
    "fastify": "^5.2.1"

  },
  "devDependencies": {
    "@notebook/tsconfig": "workspace:*",
    "@types/node": "^22.13.1",
    "tsdown": "^0.23.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
