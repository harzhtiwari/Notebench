{
  "$meta": {
    "name": "Notebench design tokens",
    "prefix": "nb",
    "rule": "This file is the only place a design value is written. tokens.css, tokens.ts and the Tailwind preset are generated from it by build_tokens.py. Components read variables, never values.",
    "naming": "--nb-<role>[-<variant>]. Name the role, never the look: ground, not background; marker-wash, not yellow-200."
  },

  "color": {
    "light": {
      "ground":        "#F5F4F1",
      "sheet":         "#FFFFFF",
      "well":          "#EEEDE9",
      "well-hover":    "#E5E4DF",
      "edge":          "#767671",
      "hairline":      "#E1E0DB",

      "ink":           "#161615",
      "ink-2":         "#43433F",
      "ink-3":         "#5C5C57",
      "ink-inv":       "#FFFFFF",

      "link":          "#1D5BD8",
      "link-wash":     "#E2EBFC",

      "you":           "#0F6A5B",
      "you-wash":      "#D9EBE6",
      "ai":            "#5B4BC4",
      "ai-wash":       "#E8E5F8",

      "marker":        "#F2D64B",
      "marker-text":   "#7A6710",
      "marker-wash":   "#F6E8A6",
      "marker-swipe":  "#F4E07A",
      "on-marker":     "#161615",

      "ok":            "#1F6B3A",
      "ok-wash":       "#DDEEE3",
      "warn":          "#8A5A00",
      "warn-wash":     "#F5E5BF",
      "danger":        "#B5301D",
      "danger-wash":   "#F7DDD7",

      "scrim":         "rgba(22, 22, 21, 0.45)",
      "select":        "#CFE0FA",
      "hatch":         "#77776F",
      "focus":         "#161615",
      "disabled-fg":   "#8C8C86",
      "disabled-bg":   "#EEEDE9",

      "chart-1":       "#302460",
      "chart-2":       "#C45F1C",
      "chart-3":       "#128181",
      "chart-4":       "#A31CC4",

      "tool-cobalt":   "#2563EB",
      "tool-amber":    "#B45309",
      "tool-rose":     "#D6336C",
      "tool-emerald":  "#0F8A5F",
      "tool-cyan":     "#0284A8",
      "tool-purple":   "#7C3AED",
      "tool-indigo":   "#4F46E5",
      "tool-teal":     "#0D8A80"
    },
    "dark": {
      "ground":        "#0F0F0F",
      "sheet":         "#1F1F1F",
      "well":          "#161616",
      "well-hover":    "#2B2B2B",
      "edge":          "#7C7C7C",
      "hairline":      "#2D2D2D",

      "ink":           "#F2F2F2",
      "ink-2":         "#C7C7C7",
      "ink-3":         "#9A9A9A",
      "ink-inv":       "#0F0F0F",

      "link":          "#7FAEFF",
      "link-wash":     "#1A2B49",

      "you":           "#4DB6A1",
      "you-wash":      "#14302A",
      "ai":            "#A99BFF",
      "ai-wash":       "#262046",

      "marker":        "#E3C646",
      "marker-text":   "#E3C646",
      "marker-wash":   "#3A3411",
      "marker-swipe":  "#5C4F10",
      "on-marker":     "#161615",

      "ok":            "#6FD39A",
      "ok-wash":       "#173222",
      "warn":          "#E2B04A",
      "warn-wash":     "#38290B",
      "danger":        "#F08A78",
      "danger-wash":   "#3B1C17",

      "scrim":         "rgba(0, 0, 0, 0.62)",
      "select":        "#1B2F4F",
      "hatch":         "#8A8A8A",
      "focus":         "#F2F2F2",
      "disabled-fg":   "#6B6B6B",
      "disabled-bg":   "#1A1A1A",

      "chart-1":       "#8974DC",
      "chart-2":       "#E64C8A",
      "chart-3":       "#67CFE9",
      "chart-4":       "#8AD05A",

      "tool-cobalt":   "#76A0FF",
      "tool-amber":    "#F2A04A",
      "tool-rose":     "#F872B9",
      "tool-emerald":  "#3FDDA0",
      "tool-cyan":     "#4DD2E1",
      "tool-purple":   "#A47DFF",
      "tool-indigo":   "#818CF8",
      "tool-teal":     "#2DD4BF"
    }
  },

  "shadow": {
    "light": {
      "float": "0 1px 2px rgba(22, 22, 21, 0.06), 0 8px 24px rgba(22, 22, 21, 0.12)",
      "modal": "0 2px 4px rgba(22, 22, 21, 0.08), 0 24px 56px rgba(22, 22, 21, 0.22)"
    },
    "dark": {
      "float": "0 1px 2px rgba(0, 0, 0, 0.5), 0 8px 24px rgba(0, 0, 0, 0.5)",
      "modal": "0 2px 4px rgba(0, 0, 0, 0.5), 0 24px 56px rgba(0, 0, 0, 0.7)"
    }
  },

  "font": {
    "ui":   "\"Atkinson Hyperlegible Next Variable\", \"Atkinson Hyperlegible Next\", \"Atkinson Hyperlegible\", system-ui, -apple-system, \"Segoe UI\", sans-serif",
    "read": "\"Literata Variable\", \"Literata\", \"Iowan Old Style\", Georgia, serif",
    "mono": "\"Atkinson Hyperlegible Mono Variable\", \"Atkinson Hyperlegible Mono\", ui-monospace, \"SF Mono\", Menlo, Consolas, monospace"
  },

  "text": {
    "2xs": "0.75rem",
    "xs":  "0.8125rem",
    "sm":  "0.875rem",
    "md":  "1rem",
    "lg":  "1.0625rem",
    "xl":  "1.25rem",
    "2xl": "1.5rem",
    "3xl": "2.5rem"
  },
  "leading": { "tight": "1.2", "ui": "1.5", "read": "1.65", "none": "1" },
  "weight":  { "regular": "400", "medium": "500", "semibold": "600", "bold": "700" },
  "tracking": { "tight": "-0.01em", "normal": "0" },

  "space": {
    "0": "0", "0.5": "0.125rem", "1": "0.25rem", "2": "0.5rem", "3": "0.75rem", "4": "1rem",
    "5": "1.25rem", "6": "1.5rem", "8": "2rem", "10": "2.5rem", "12": "3rem", "16": "4rem", "24": "6rem"
  },

  "radius": {
    "xs": "4px", "sm": "8px", "md": "12px", "lg": "16px", "xl": "24px", "full": "9999px"
  },
  "radius-role": {
    "panel":   "{radius.xl}",
    "modal":   "{radius.xl}",
    "composer": "{radius.xl}",
    "card":    "{radius.lg}",
    "well":    "{radius.md}",
    "input":   "{radius.md}",
    "menu":    "{radius.md}",
    "control": "{radius.full}",
    "chip":    "{radius.full}",
    "tag":     "{radius.xs}",
    "rail":    "{radius.full}"
  },

  "border": { "1": "1px", "2": "2px", "rail": "4px" },
  "ring":   { "width": "2px", "offset": "2px" },

  "size": {
    "icon-sm": "1rem",
    "icon-md": "1.25rem",
    "icon-lg": "1.5rem",
    "control-sm": "1.75rem",
    "control-md": "2.25rem",
    "control-lg": "2.75rem",
    "target-min": "1.5rem",
    "logo": "2.5rem",
    "tile-icon": "2.25rem",
    "switch-w": "2.75rem",
    "switch-h": "1.5rem",
    "progress": "0.5rem",
    "textarea-min": "5rem",
    "composer-min": "8rem"
  },
  "size-coarse": { "control-md": "2.75rem", "control-sm": "2.75rem" },

  "layout": {
    "gutter": "0.875rem",
    "header-h": "4.5rem",
    "panel-w": "18rem",
    "panel-w-collapsed": "3.5rem",
    "composer-h": "4.875rem",
    "chat-max": "46rem",
    "app-max": "90rem",
    "modal-sm": "28rem",
    "modal-md": "40rem",
    "modal-lg": "56rem",
    "popover-w": "24rem",
    "measure": "66ch",
    "title-min": "14rem"
  },

  "z": { "base": "0", "raised": "1", "header": "30", "popover": "40", "modal": "50", "toast": "60" },

  "motion": {
    "dur-fast": "100ms",
    "dur-base": "180ms",
    "dur-slow": "240ms",
    "dur-spin": "800ms",
    "ease": "cubic-bezier(0.16, 1, 0.3, 1)"
  },

  "breakpoint": { "sm": "30rem", "md": "43.75rem", "lg": "68.75rem" },

  "icon": {
    "library": "phosphor",
    "weight-default": "regular",
    "weight-active": "fill",
    "weight-small": "bold"
  }
}
