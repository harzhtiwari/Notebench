{
  "name": "@notebook/ui",
  "version": "0.1.0",
  "description": "Accessible UI component primitives and design system for Notebench",
  "private": true,
  "type": "module",
  "license": "MIT",
  "files": [
    "dist/**",
    "tokens.css",
    "tokens.media.css",
    "tailwind.preset.cjs"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./tokens.css",
    "./tokens.media.css": "./tokens.media.css"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@notebook/contracts": "workspace:*",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-accordion": "^1.3.0",
    "@radix-ui/react-dialog": "^1.3.0",
    "@radix-ui/react-dropdown-menu": "^2.2.0",
    "@radix-ui/react-popover": "^1.3.0",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.0",
    "@radix-ui/react-tooltip": "^1.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react-resizable-panels": "^2.1.9",
    "tailwind-merge": "^3.7.0"
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@notebook/tsconfig": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "^21.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4",
    "publint": "^0.3.25",
    "@arethetypeswrong/core": "^0.18.5"
  }
}
