{
  "name": "@notebook/infra-db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "import": "./dist/schema/index.js"
    },
    "./sqlite": {
      "types": "./dist/sqlite/index.d.ts",
      "import": "./dist/sqlite/index.js"
    },
    "./pg": {
      "types": "./dist/pg/index.d.ts",
      "import": "./dist/pg/index.js"
    },
    "./migrator": {
      "types": "./dist/migrator/index.d.ts",
      "import": "./dist/migrator/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@notebook/contracts": "workspace:*",
    "@notebook/logger": "workspace:*",
    "better-sqlite3": "12.11.1",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.13.3"
  },
  "devDependencies": {
    "@notebook/tsconfig": "workspace:*",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.13.1",
    "@types/pg": "^8.11.11",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
