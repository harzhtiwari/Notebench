    "turndown": "^7.2.0",
    "undici": "^7.2.1"
  },
  "devDependencies": {
    "@notebook/tsconfig": "workspace:*",
    "@types/node": "^22.13.1",
    "@types/sanitize-html": "^2.16.2",
    "@types/turndown": "^5.0.6",
    "tsdown": "^0.23.0",
