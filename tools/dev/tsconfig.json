{
  "extends": "@notebench/tsconfig/build.json",
  "compilerOptions": {
    "lib": ["ES2022", "ES2023.Array", "ES2024.Promise"],
    // Tests observe the web compiler config seam (`apps/web/next.config.ts`),
    // which lives outside this package: root at the repo root so the whole
    // program (src + tests + observed config) stays under rootDir.
    // This config is typecheck-only (no build/emit script).
    "rootDir": "../.."
  },
  "include": ["src/**/*", "tests/**/*"]
}
