{
  "$schema": "https://unpkg.com/knip@5/overview/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.ts"]
    },
    "apps/server": {},
    "apps/web": {
      "entry": ["src/app/**/page.tsx", "src/app/**/layout.tsx"]
    },
    "packages/*": {},
    "examples/*": {}
  },
  "rules": {
    "duplicates": "off"
  },
  "ignoreDependencies": [
    "@stryker-mutator/vitest-runner",
    "drizzle-kit",
    "pino-pretty",
    "pino-roll",
    "next"
  ]
}
